{
  "manifest_version": 3,
  "name": "Reels Control Bar",
  "version": "1.0.0",
  "description": "Control bar, keyboard shortcuts, playback speed and auto-next for Reels on the web. Unofficial; not affiliated with Instagram.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Reels Control Bar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
